# Names only. Values stay local or in hosting. Never commit real values.
RPC_URL=https://rpc.ankr.com/whitechain_testnet
CHAIN_ID=1874
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
ROUTER_ADDRESS=
RELAYER_PRIVATE_KEY=
OPERATOR_TOKEN=
MERCHANT_API_KEYS=
WEBHOOK_SECRET=
DATABASE_PATH=./quietpay.db
LOSS_BUDGET_WBT_PER_HOUR=0.05
MAX_GAS_PRICE=
PAYER_CAP_USDT=100
# Deploy-only (local shell, never hosting)
DEPLOYER_PRIVATE_KEY=

# Relayer safety and recovery
MAX_GAS_LIMIT=500000
LOW_BALANCE_WBT=0.01
PENDING_RETRY_SECONDS=30
MAX_REPLACEMENTS=3

# Read-only ledger/indexer service (separate database and HTTP port)
# Set the actual router deployment block before starting. No default is assumed.
INDEXER_FROM_BLOCK=
INDEXER_DATABASE_PATH=./quietpay-indexer.db
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_MS=5000
INDEXER_PORT=8788
# Optional: set both only when accounting for direct transfers to an API owner's wallet.
# FACILITATOR_PAYTO=
# FACILITATOR_MERCHANT_ID=

# Combined relayer/facilitator and separate paid API
# Also fill/uncomment FACILITATOR_PAYTO and FACILITATOR_MERCHANT_ID above.
PAID_API_PUBLIC_URL=http://localhost:8790
FACILITATOR_URL=http://localhost:8787
PAID_API_PORT=8790
QUIETPAY_API_KEY=
X402_QUOTE_AMOUNT=10000
X402_SIGNAL_AMOUNT=20000
X402_SETTLEMENT_WAIT_MS=5000

# Scripted paying agent (a separate, zero-native-balance test payer; never the relayer key)
AGENT_PRIVATE_KEY=
AGENT_PER_CALL_LIMIT=20000
AGENT_SESSION_BUDGET=30000
AGENT_EXPLORER_URL=

# Token authorization domain; must match the configured token.
TOKEN_DOMAIN_NAME=Tether USD
TOKEN_DOMAIN_VERSION=1
