# Names only. Values stay local or in hosting. Never commit real values.
RPC_URL=https://rpc.ankr.com/whitechain_testnet
CHAIN_ID=1874
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# EIP-712 domain of the official test USDT (read from the token; do not change for the bounty).
TOKEN_DOMAIN_NAME=Tether USD
TOKEN_DOMAIN_VERSION=1
ROUTER_ADDRESS=0xb9D475cdd817900B45C356169c6FdC379B942d82
RELAYER_PRIVATE_KEY=
OPERATOR_TOKEN=
# apiKey:0x<bytes32 merchantId>, comma separated. Each apiKey must be at least 24 characters.
MERCHANT_API_KEYS=
# Master webhook key (never given to merchants). Each merchant verifies with its own derived secret:
#   printf %s 0x<merchantId lowercase> | openssl dgst -sha256 -hmac "$WEBHOOK_SECRET"
WEBHOOK_SECRET=
# 1 = allow loopback/private webhook URLs. Local dev only; keep 0 in hosting.
ALLOW_PRIVATE_WEBHOOKS=0
DATABASE_PATH=./quietpay.db
LOSS_BUDGET_WBT_PER_HOUR=0.05
MAX_GAS_PRICE=
PAYER_CAP_USDT=100
# Trusted reverse proxies in front of the relayer (Render = 1). 0 = ignore X-Forwarded-For (use the socket address).
# Only set this when every request really passes through that many proxies you control, or clients can spoof their IP.
TRUST_PROXY_HOPS=0
# Deploy-only (local shell, never hosting)
DEPLOYER_PRIVATE_KEY=

# Indexer
FACILITATOR_PAYTO=
CONFIRMATIONS=12

# Backend extension settings (see docs/b/frontend-integration.md).
MAX_GAS_LIMIT=500000
LOW_BALANCE_WBT=0.01
PENDING_RETRY_SECONDS=30
MAX_REPLACEMENTS=3
INDEXER_FROM_BLOCK=
INDEXER_DATABASE_PATH=./quietpay-indexer.db
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_MS=5000
INDEXER_PORT=8788
PAID_API_PUBLIC_URL=http://localhost:8790
FACILITATOR_URL=http://localhost:8787
PAID_API_PORT=8790
QUIETPAY_API_KEY=
X402_QUOTE_AMOUNT=10000
X402_SIGNAL_AMOUNT=20000
X402_SETTLEMENT_WAIT_MS=5000
AGENT_PRIVATE_KEY=
AGENT_PER_CALL_LIMIT=20000
AGENT_SESSION_BUDGET=30000
AGENT_EXPLORER_URL=

# Hosting additions (docs/b/build/config-matrix.md "Mismatches"; defaults shown).
SETTLE_CONFIRMATIONS=1
RELAY_FEE_USDT=0.05
RATE_LIMIT_PER_MINUTE=20
ORDERS_PER_MINUTE_PER_MERCHANT=1200
PORT=8787
MIN_VALID_SECONDS=60
REVERTED_PAYER_MIN_VALID_SECONDS=120
MAX_REVERTS_PER_DAY=2
PAYER_LOSS_SHARE_PERCENT=25
TX_MAX_AGE_SECONDS=1800
FIRST_TIME_PAYER_LOSS_SHARE_PERCENT=5
FIRST_TIME_PAYER_LOSS_CAP_PERCENT=100
MAX_NEW_PAYERS_PER_IP_PER_HOUR=10
RECONCILE_INTERVAL_SECONDS=30
CORS_ORIGINS=
FACILITATOR_MERCHANT_ID=
# Merchant server (apps/demo-store/server). HOST=0.0.0.0 in hosting; loopback by default.
HOST=127.0.0.1
QUIETPAY_BASE_URL=http://localhost:8787
QUIETPAY_WEBHOOK_SECRET=
QUIETPAY_MERCHANT_ID=
QUIETPAY_PAYOUT_ADDRESS=
QUIETPAY_WEBHOOK_URL=
QUIETPAY_STATE_FILE=.data/demo-store-state.json
QUIETPAY_RECEIPT_DATABASE_PATH=quietpay-receipts.db
QUIETPAY_MERCHANT_DATABASE_PATH=quietpay-merchant.db
QUIETPAY_DASHBOARD_TOKEN=
QUIETPAY_ROUTER_ADDRESS=
QUIETPAY_CHAIN_ID=1874
QUIETPAY_TOKEN_ADDRESS=
QUIETPAY_REFUND_SIGNER_PRIVATE_KEY=
# Indexer CLI names (the ledger API uses the INDEXER_* names above).
DEPLOY_BLOCK=
POLL_SECONDS=
# Relayer database backups (deploy/start.sh runs them on this schedule in hosting).
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=14
EXPLORER_BASE_URL=https://testnet.whitechain.io
