# Copy to .env and fill in. Never commit .env.
QUIETPAY_BASE_URL=
QUIETPAY_API_KEY=
QUIETPAY_MERCHANT_ID=
QUIETPAY_WEBHOOK_SECRET=
# Your merchant payout address (0x...), the one registered for QUIETPAY_MERCHANT_ID on the PaymentRouter.
# The server refuses orders the relayer creates with any other payout, and the checkout widget refuses to sign one.
# Recommended; if empty, the payout reported by the relayer when the order is created is pinned instead.
QUIETPAY_PAYOUT_ADDRESS=
# Optional: where paid orders / processed webhook ids are persisted (default .data/demo-store-state.json).
QUIETPAY_STATE_FILE=

# Required to enable authenticated dashboard order/refund routes.
# Generate a separate high-entropy token (at least 32 characters). Enter it in the dashboard.
# Never use the relayer API key as this token; keep all values out of VITE_*.
QUIETPAY_DASHBOARD_TOKEN=
QUIETPAY_ROUTER_ADDRESS=
QUIETPAY_REFUND_SIGNER_PRIVATE_KEY=
# Persistent SQLite file, separate from the relayer database. Back it up with WAL/SHM consistently.
QUIETPAY_MERCHANT_DATABASE_PATH=quietpay-merchant.db

QUIETPAY_WEBHOOK_URL=
QUIETPAY_RECEIPT_DATABASE_PATH=quietpay-receipts.db
QUIETPAY_CHAIN_ID=1874
QUIETPAY_TOKEN_ADDRESS=
TOKEN_DOMAIN_NAME=Tether USD
TOKEN_DOMAIN_VERSION=1
