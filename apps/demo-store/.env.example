# Copy to .env and fill in. Never commit .env.
QUIETPAY_BASE_URL=
QUIETPAY_API_KEY=
QUIETPAY_MERCHANT_ID=
QUIETPAY_WEBHOOK_SECRET=
# Your merchant payout address (0x...), the one registered for QUIETPAY_MERCHANT_ID on the PaymentRouter.
# The server refuses orders the relayer creates with any other payout, and the checkout widget refuses to sign one.
# Recommended; if empty, the payout reported by the relayer when the order is created is pinned instead.
QUIETPAY_PAYOUT_ADDRESS=
# Optional: where paid orders / processed webhook ids are persisted (default .data/demo-store-state.json).
QUIETPAY_STATE_FILE=
