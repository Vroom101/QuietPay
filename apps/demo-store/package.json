{
  "name": "@quietpay/demo-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch --env-file-if-exists=.env server/index.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start:server": "tsx --env-file-if-exists=.env server/index.ts",
    "simulate-webhook": "tsx --env-file-if-exists=.env scripts/simulate-webhook.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@quietpay/merchant-sdk": "workspace:*",
    "@quietpay/shared": "workspace:*",
    "@quietpay/widget": "workspace:*",
    "fastify": "^4.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "better-sqlite3": "^11.5.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}
