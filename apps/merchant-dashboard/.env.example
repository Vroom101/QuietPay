# Copy to .env.local. All VITE_* values are public; never put keys/tokens here.
# Default uses the same-origin Vite /api proxy to the merchant server on 127.0.0.1:3001.
VITE_MERCHANT_API_URL=/api/merchant
VITE_MERCHANT_NAME=Quiet Store
# Set to 1 to read payments from the simulated storefront API.
VITE_DEMO_MODE=
# Enter the merchant server's QUIETPAY_DASHBOARD_TOKEN in the page, not the relayer API key.
